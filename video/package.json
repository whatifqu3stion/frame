{
  "name": "frame-onboarding-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render:guide": "remotion render src/index.ts ViewingGuide ../expo/assets/welcome/viewing-guide.mp4 --codec=h264 --crf=20 --muted",
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:preview": "remotion render src/index.ts FramePreview out/frame-symbol-soft-shadow-preview.mp4 --codec=h264 --crf=17",
    "render:alpha": "remotion render src/index.ts FrameTransparent out/frame-symbol-grounded-alpha.webm --codec=vp9 --pixel-format=yuva420p --image-format=png --crf=20",
    "render:master": "remotion render src/index.ts FrameTransparent out/frame-symbol-grounded-master.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@react-three/fiber": "^9.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/three": "^0.180.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  }
}
